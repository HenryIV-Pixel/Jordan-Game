{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Al-Mamlaka",
  "version": "0.1.0",
  "identifier": "com.grie.jordanstrategy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "المملكة — 1953",
        "width": 1600,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 720,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Arabic",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "mainBinaryName": "al-mamlaka"
}